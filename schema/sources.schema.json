{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sources.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sources"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id","url","url_pinned","local_path","sha256","doc_type","tier","version","publication_date","applicable_models","not_applicable_models","retrieved_at"],
        "properties": {
          "id":     { "type": "string", "minLength": 1 },
          "url":    { "type": "string" },
          "url_pinned": { "type": ["string","null"] },
          "local_path": { "type": ["string","null"] },
          "sha256":     { "type": ["string","null"] },
          "doc_type":   { "type": "string", "enum": ["hardware_design","at_command_manual","application_note","other"] },
          "tier":       { "type": "string", "enum": ["primary","secondary"] },
          "version":    { "type": "string" },
          "publication_date": { "type": ["string","null"] },
          "applicable_models":     { "type": "array", "items": { "type": "string" } },
          "not_applicable_models": { "type": "array", "items": { "type": "string" } },
          "retrieved_at": { "type": "string" }
        }
      }
    }
  }
}